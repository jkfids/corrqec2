\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=boxyellow] (0) at (0.75, 0) {\(A\)};
		\node [style=boxgreen] (1) at (2, 0) {\(B\)};
		\node [style=none] (2) at (0, 0) {};
		\node [style=none] (3) at (2.75, 0) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw (0) to (1);
		\draw (1) to (3.center);
		\draw (2.center) to (0);
	\end{pgfonlayer}
\end{tikzpicture}
