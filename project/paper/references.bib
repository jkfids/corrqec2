@online{kobayashiTensornetworkDecodersProcess2024,
  title = {Tensor-Network Decoders for Process Tensor Descriptions of Non-{{Markovian}} Noise},
  author = {Kobayashi, Fumiyoshi and Manabe, Hidetaka and White, Gregory A. L. and Farrelly, Terry and Modi, Kavan and Stace, Thomas M.},
  date = {2024-12-18},
  eprint = {2412.13739},
  eprinttype = {arXiv},
  eprintclass = {quant-ph},
  doi = {10.48550/arXiv.2412.13739},
  url = {http://arxiv.org/abs/2412.13739},
  urldate = {2025-01-27},
  abstract = {Quantum error correction (QEC) is essential for fault-tolerant quantum computation. Often in QEC errors are assumed to be independent and identically distributed and can be discretised to a random Pauli error during the execution of a quantum circuit. In real devices, however, the noise profile is much more complex and contains non-trivial spatiotemporal correlations, such as cross-talk, non-Markovianity, and their mixtures. Here, we examine the performance of two paradigmatic QEC codes in the presence of complex noise by using process tensors to represent spatiotemporal correlations beyond iid errors. This integration is an instance of the recently proposed \textbackslash textit\{strategic code\}, which combines QEC with process tensors. In particular, we construct the maximum likelihood (ML) decoder for a quantum error correction code with a process tensor. To understand the computational overhead and implications of this approach, we implement our framework numerically for small code instances and evaluate its performance. We also propose a method to evaluate the performance of strategic codes and construct the ML decoder with an efficient tensor network approximation. Our results highlight the possible detrimental effects of correlated noise and potential pathways for designing decoders that account for such effects.},
  pubstate = {prepublished},
  keywords = {Quantum Physics},
  file = {/home/fidel/Zotero/storage/9LYTTJQM/Kobayashi et al. - 2024 - Tensor-network decoders for process tensor descriptions of non-Markovian noise.pdf;/home/fidel/Zotero/storage/HC9ET32R/2412.13739v1.pdf;/home/fidel/Zotero/storage/KB2TP9YD/2412.html}
}

@online{liuNonMarkovianNoiseSuppression2024,
  title = {Non-{{Markovian Noise Suppression Simplified}} through {{Channel Representation}}},
  author = {Liu, Zhenhuan and Xiao, Yunlong and Cai, Zhenyu},
  date = {2024-12-15},
  eprint = {2412.11220},
  eprinttype = {arXiv},
  eprintclass = {quant-ph},
  doi = {10.48550/arXiv.2412.11220},
  url = {http://arxiv.org/abs/2412.11220},
  urldate = {2025-09-09},
  abstract = {Non-Markovian noise, arising from the memory effect in the environment, poses substantial challenges to conventional quantum noise suppression protocols, including quantum error correction and mitigation. We introduce a channel representation for arbitrary non-Markovian quantum dynamics, termed the Choi channel, as it operates on the Choi states of the ideal gate layers. This representation translates the complex dynamics of non-Markovian noise into the familiar picture of noise channels acting on ideal states, allowing us to directly apply many existing error suppression protocols originally designed for Markovian noise. These protocols can then be translated from the Choi channel picture back to the circuit picture, yielding non-Markovian noise suppression protocols. With this framework, we have devised new protocols using Pauli twirling, probabilistic error cancellation and virtual channel purification. In particular, Pauli twirling can transform any non-Markovian noise into noise that exhibits only classical temporal correlations, thereby extending the proven noise resilience of single-shot quantum error correction to arbitrary non-Markovian noise. Through these examples, the Choi channel demonstrates significant potential as a foundational bridge for connecting existing techniques and inspiring the development of novel non-Markovian noise suppression protocols.},
  pubstate = {prepublished},
  keywords = {Quantum Physics},
  file = {/home/fidel/Zotero/storage/6SPLDDNF/Liu et al. - 2024 - Non-Markovian Noise Suppression Simplified through Channel Representation.pdf;/home/fidel/Zotero/storage/Q93GCFZI/2412.html}
}

@online{liuRealizingUniversalNonMarkovian2025,
  title = {Realizing {{Universal Non-Markovian Noise Suppression}}},
  author = {Liu, Hongfeng and Han, Zizhao and Nie, Xinfang and Liu, Zhenhuan and Lu, Dawei},
  date = {2025-11-25},
  eprint = {2511.20304},
  eprinttype = {arXiv},
  eprintclass = {quant-ph},
  doi = {10.48550/arXiv.2511.20304},
  url = {http://arxiv.org/abs/2511.20304},
  urldate = {2025-12-02},
  abstract = {Non-Markovian noise, arising from environmental memory effects, is the most general and challenging form of noise in quantum computing, and is typically difficult to characterize and suppress. Here, we analyze and experimentally demonstrate a non-Markovian noise suppression scheme inspired by quantum purification protocols. We theoretically prove that, even without noise calibration and assumptions on specific noise models, the scheme can exponentially reduce non-Markovian error rates with respect to the ancillary system size. We implement the protocol using nuclear spins, demonstrating that non-Markovian noise can be suppressed for both unitary operations and non-unitary channels. The observed fidelities and process tomography show close agreement with theoretical predictions, confirming the practicality and effectiveness of the scheme.},
  pubstate = {prepublished},
  keywords = {Quantum Physics},
  file = {/home/fidel/Zotero/storage/WMLN68IX/Liu et al. - 2025 - Realizing Universal Non-Markovian Noise Suppression.pdf;/home/fidel/Zotero/storage/PIMXJ8FA/2511.html}
}

