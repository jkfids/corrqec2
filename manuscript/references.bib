@misc{hinesSimulatingQuantumError2026,
  title = {Simulating {{Quantum Error Correction}} beyond {{Pauli Stochastic Errors}}},
  author = {Hines, Jordan and Ostrove, Corey and Rudinger, Kenneth and Seritan, Stefan and Young, Kevin and {Blume-Kohout}, Robin and Proctor, Timothy},
  year = 2026,
