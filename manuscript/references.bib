@misc{myersSimulatingGeneralNoise2025,
  title = {Simulating General Noise Nearly as Cheaply as {{Pauli}} Noise},
  author = {Myers, Mark and Teo, Mariesa H. and Mishra, Rajesh and Chai, Jing Hao and Ng, Hui Khoon},
  year = 2025,
