@article{greenbaumModelingCoherentErrors2017,
  title = {Modeling Coherent Errors in Quantum Error Correction},
  author = {Greenbaum, Daniel and Dutton, Zachary},
  year = 2017,
  month = dec,
  journal = {Quantum Science and Technology},
  volume = {3},
  number = {1},
  pages = {015007},
  publisher = {IOP Publishing},
  issn = {2058-9565},
  doi = {10.1088/2058-9565/aa9a06},
  abstract = {Analysis of quantum error correcting codes is typically done using a stochastic, Pauli channel error model for describing the noise on physical qubits. However, it was recently found that coherent errors (systematic rotations) on physical data qubits result in both physical and logical error rates that differ significantly from those predicted by a Pauli model. Here we examine the accuracy of the Pauli approximation for noise containing coherent errors (characterized by a rotation angle {$\epsilon$}) under the repetition code. We derive an analytic expression for the logical error channel as a function of arbitrary code distance d and concatenation level n, in the small error limit. We find that coherent physical errors result in logical errors that are partially coherent and therefore non-Pauli. However, the coherent part of the logical error is negligible at fewer than  error correction cycles when the decoder is optimized for independent Pauli errors, thus providing a regime of validity for the Pauli approximation. Above this number of correction cycles, the persistent coherent logical error will cause logical failure more quickly than the Pauli model would predict, and this may need to be combated with coherent suppression methods at the physical level or larger codes.}
}

